# 投研问答助手 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── CoPaw 桥接配置 ──
# CoPaw 聊天 API 地址（可选，未配置时跳过 CoPaw）
IRA_COPAW_CHAT_URL=

# ── 百炼/DashScope 配置 ──
# 阿里云百炼 API Key（可选，未配置时跳过百炼）
DASHSCOPE_API_KEY=

# ── 说明 ──
# 1. 至少配置一个 AI 服务（CoPaw 或百炼）以获得真实问答能力
# 2. 如果都不配置，系统将使用 Demo 离线演示模式
# 3. 降级顺序：CoPaw → 百炼 → Demo
# 4. 密钥不要提交到代码仓库
